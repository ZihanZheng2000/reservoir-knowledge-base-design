{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "index_record.schema.json",
  "title": "Reservoir Encoded Knowledge Record",
  "type": "object",
  "required": ["index_record_id", "record_type", "record_id", "reservoir_id", "reservoir_name", "index_text", "engineering_dimension", "primary_pattern", "source_ids", "based_on_eu_ids", "based_on_knowledge_card_ids", "source_locators", "confidence", "evidence_depth"],
  "properties": {
    "index_record_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["evidence_unit", "knowledge_card", "synthesis_card"]},
    "record_id": {"type": "string", "minLength": 1},
    "reservoir_id": {"type": "string", "minLength": 1},
    "reservoir_name": {"type": "string", "minLength": 1},
    "index_text": {"type": "string", "minLength": 1},
    "engineering_dimension": {"type": "string"},
    "primary_pattern": {"type": "string"},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "based_on_eu_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "based_on_knowledge_card_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_locators": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "evidence_depth": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
