{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_manifest.schema.json",
  "title": "Reservoir Source Manifest",
  "$defs": {
    "source_candidate": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "document_type": {"type": "string"},
        "selection_reason": {"type": "string"},
        "source_tier": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {"type": "array", "items": {"$ref": "#/$defs/source_candidate"}},
    {"type": "object", "required": ["sources"], "properties": {"sources": {"type": "array", "items": {"$ref": "#/$defs/source_candidate"}}}, "additionalProperties": true}
  ]
}
