{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage_manifest.schema.json",
  "title": "Reservoir Knowledge-Base Stage Manifest",
  "type": "object",
  "required": ["run_id", "stage", "workflow_version", "status", "inputs", "outputs", "automated_validation", "human_review", "cleanup", "warnings", "unresolved_issues", "downstream_readiness"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["source_acquisition", "evidence_extraction", "knowledge_consolidation", "synthesis", "indexing", "report_generation"]},
    "workflow_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["not_started", "in_progress", "completed", "completed_with_warnings", "failed"]},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "automated_validation": {
      "type": "object",
      "required": ["schema_conformance", "traceability_or_acquisition", "artifact_path"],
      "properties": {
        "schema_conformance": {"$ref": "#/$defs/indicator"},
        "traceability_or_acquisition": {"$ref": "#/$defs/indicator"},
        "artifact_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "human_review": {
      "type": "object",
      "required": ["status", "artifact_path"],
      "properties": {
        "status": {"enum": ["not_requested", "not_reviewed", "in_progress", "completed"]},
        "artifact_path": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": ["status", "removed_paths"],
      "properties": {
        "status": {"enum": ["not_run", "completed", "skipped"]},
        "removed_paths": {"type": "array", "items": {"type": "string"}},
        "downgraded_to_optional": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "unresolved_issues": {"type": "array", "items": {"type": "string"}},
    "downstream_readiness": {"enum": ["ready", "conditional", "blocked"]}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["name", "path", "format", "required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "format": {"enum": ["json", "jsonl", "markdown", "csv", "directory", "pdf", "docx", "pptx", "other"]},
        "schema": {"type": ["string", "null"]},
        "record_count": {"type": ["integer", "null"], "minimum": 0},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "indicator": {
      "type": "object",
      "required": ["name", "status", "issue_count"],
      "properties": {
        "name": {"enum": ["schema_conformance", "traceability_integrity", "acquisition_success"]},
        "status": {"enum": ["pass", "warning", "fail"]},
        "issue_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
