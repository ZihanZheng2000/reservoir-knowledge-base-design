{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synthesis_card.schema.json",
  "title": "Reservoir Synthesis Card",
  "type": "object",
  "required": ["synthesis_card_id", "knowledge_layer", "reservoir_id", "reservoir_name", "primary_pattern", "secondary_lenses", "title", "operational_question", "synthesis_claim", "scope_and_conditions", "analysis_chain", "based_on_eu_ids", "based_on_knowledge_card_ids", "evidence_role_map", "uncertainty_or_exception", "operational_implication", "confidence", "next_step", "evidence_depth", "notes"],
  "properties": {
    "synthesis_card_id": {"type": "string", "minLength": 1},
    "knowledge_layer": {"const": "synthesis_analysis"},
    "reservoir_id": {"type": "string", "minLength": 1},
    "reservoir_name": {"type": "string", "minLength": 1},
    "primary_pattern": {"enum": ["decision_process", "constraint_structure", "operational_tradeoff", "operating_regime_change", "historical_operation_failure", "operational_consequence"]},
    "secondary_lenses": {"type": "array", "uniqueItems": true, "items": {"enum": ["decision_process", "constraint_structure", "operational_tradeoff", "operating_regime_change", "historical_operation_failure", "operational_consequence"]}},
    "title": {"type": "string", "minLength": 1},
    "operational_question": {"type": "string", "minLength": 1},
    "synthesis_claim": {"type": "string", "minLength": 1},
    "scope_and_conditions": {"type": "string", "minLength": 1},
    "analysis_chain": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["stage", "statement", "based_on_eu_ids"], "properties": {"stage": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "based_on_eu_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "based_on_eu_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "based_on_knowledge_card_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence_role_map": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["role", "eu_ids"], "properties": {"role": {"type": "string", "minLength": 1}, "eu_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "additionalProperties": false}},
    "uncertainty_or_exception": {"type": "string", "minLength": 1},
    "operational_implication": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["high", "medium", "low"]},
    "next_step": {"type": "string"},
    "evidence_depth": {"enum": ["eu_only", "source_checked", "source_checked_with_direct_quote"]},
    "source_locator_summary": {"type": "string", "minLength": 1},
    "source_verification_note": {"type": "string", "minLength": 1},
    "consequence_basis": {"enum": ["observed_consequence", "modeled_consequence", "projected_consequence"]},
    "failure_episode": {"type": "object", "required": ["failure_class"], "properties": {"failure_class": {"enum": ["complete_failure", "partial_failure", "temporary_loss_of_function", "capacity_degradation", "target_nonachievement", "emergency_deviation", "institutional_or_coordination_failure", "uncertain_failure_status"]}}, "additionalProperties": true},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"evidence_depth": {"enum": ["source_checked", "source_checked_with_direct_quote"]}}}, "then": {"required": ["source_locator_summary", "source_verification_note"]}},
    {"if": {"properties": {"primary_pattern": {"const": "operational_consequence"}}}, "then": {"required": ["consequence_basis"]}},
    {"if": {"properties": {"primary_pattern": {"const": "historical_operation_failure"}}}, "then": {"required": ["failure_episode"]}}
  ],
  "additionalProperties": false
}
