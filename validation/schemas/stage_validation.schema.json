{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage_validation.schema.json",
  "title": "Reservoir KB Stage Validation Result",
  "type": "object",
  "required": ["stage", "status", "error_count", "warning_count", "errors", "warnings", "automated_validation"],
  "properties": {
    "stage": {"enum": ["source_acquisition", "evidence_extraction", "knowledge_consolidation", "synthesis", "indexing", "report_generation"]},
    "status": {"enum": ["pass", "warning", "fail", "not_run"]},
    "error_count": {"type": "integer", "minimum": 0},
    "warning_count": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "automated_validation": {
      "type": "object",
      "required": ["schema_conformance", "traceability_or_acquisition"],
      "properties": {
        "schema_conformance": {"$ref": "#/$defs/indicator"},
        "traceability_or_acquisition": {"$ref": "#/$defs/indicator"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "indicator": {
      "type": "object",
      "required": ["name", "status", "issue_count"],
      "properties": {
        "name": {"enum": ["schema_conformance", "traceability_integrity", "acquisition_success"]},
        "status": {"enum": ["pass", "warning", "fail"]},
        "issue_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
